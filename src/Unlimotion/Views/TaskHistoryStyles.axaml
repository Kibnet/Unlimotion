<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:unlimotion="clr-namespace:Unlimotion">
        <Style Selector="Expander.TaskStatusHistoryExpander, Expander.TaskOperationDetailsExpander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid MinWidth="{TemplateBinding MinWidth}"
                          MaxWidth="{TemplateBinding MaxWidth}"
                          RowDefinitions="Auto,*">
                        <ToggleButton x:Name="PART_HeaderSite"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      VerticalContentAlignment="Center"
                                      AutomationProperties.Name="{TemplateBinding Header}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0,5"
                                      MinHeight="28"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      IsEnabled="{TemplateBinding IsEnabled}"
                                      IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
                            <Grid ColumnDefinitions="14,*" ColumnSpacing="8" VerticalAlignment="Center">
                                <PathIcon Width="14" Height="14" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TaskHistoryHeadingBrush}"
                                          Data="M2,5 L3.4,3.6 L7,7.2 L10.6,3.6 L12,5 L7,10 Z"
                                          IsVisible="{Binding !IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                    <PathIcon.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </PathIcon.RenderTransform>
                                </PathIcon>
                                <PathIcon Width="14" Height="14" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TaskHistoryHeadingBrush}"
                                          Data="M2,5 L3.4,3.6 L7,7.2 L10.6,3.6 L12,5 L7,10 Z"
                                          IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter x:Name="TaskHistoryHeading" Grid.Column="1"
                                                  Content="{TemplateBinding Header}" VerticalAlignment="Center"
                                                  Foreground="{DynamicResource TaskHistoryHeadingBrush}" FontWeight="SemiBold"/>
                            </Grid>
                        </ToggleButton>
                        <!-- A custom name avoids Fluent's expanded-state border rule for #ExpanderContent. -->
                        <Border Grid.Row="1"
                                x:Name="TaskHistoryContent"
                                IsVisible="{TemplateBinding IsExpanded}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                MinHeight="{TemplateBinding MinHeight}"
                                HorizontalAlignment="Stretch"
                                Padding="0,2,0,0">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Expander.TaskStatusHistoryExpander /template/ ToggleButton#PART_HeaderSite:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.HistoryMode">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.HistoryIcon">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.HistoryCommit">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="{DynamicResource AppSmallFontSize}"/>
        </Style>
        <Style Selector="ListBox.HistoryEntries">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.HistoryEntries ListBoxItem" x:DataType="unlimotion:TaskHistoryEntry">
            <Setter Property="AutomationProperties.Name" Value="{Binding Heading}"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.HistoryEntries /template/ ScrollViewer">
            <Setter Property="VerticalSnapPointsType" Value="None"/>
        </Style>
</Styles>
