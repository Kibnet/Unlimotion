<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:feed="clr-namespace:Unlimotion.ViewModel.Feed;assembly=Unlimotion.ViewModel"
             xmlns:local="clr-namespace:Unlimotion"
             xmlns:views="clr-namespace:Unlimotion.Views"
             x:Class="Unlimotion.Views.FeedReviewDialog"
             x:DataType="feed:FeedViewModel"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="700">
    <Border Padding="20"
            CornerRadius="12"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemAccentColor}"
            BorderThickness="1"
            AutomationProperties.ControlTypeOverride="Group"
            AutomationProperties.IsControlElementOverride="True"
            AutomationProperties.AutomationId="FeedReviewPanel">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
              RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Text="{DynamicResource GlobalReview}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding CurrentReviewPosition}"
                           AutomationProperties.AutomationId="FeedReviewPositionText" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="{Binding CurrentReviewCount, StringFormat=/ {0}}" />
                <Button Grid.Column="3"
                        Padding="8,2"
                        Content="×"
                        Command="{Binding FinishReviewCommand}"
                        AutomationProperties.Name="{DynamicResource GlobalClose}"
                        AutomationProperties.AutomationId="FeedFinishReviewButton" />
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8"
                  IsVisible="{Binding !HasCreatedTask}">
                <Button IsEnabled="{Binding CanNavigateReviewPrevious}"
                        Command="{Binding PreviousReviewCommand}"
                        Content="{DynamicResource FeedReviewPrevious}"
                        AutomationProperties.AutomationId="FeedReviewPreviousButton" />
                <Button Grid.Column="2"
                        IsEnabled="{Binding CanNavigateReviewNext}"
                        Command="{Binding NextReviewCommand}"
                        Content="{DynamicResource FeedReviewNext}"
                        AutomationProperties.AutomationId="FeedReviewNextButton" />
            </Grid>

            <Border Grid.Row="2"
                    Padding="12"
                    CornerRadius="8"
                    Background="{DynamicResource ThemeControlLowBrush}">
                <ScrollViewer MaxHeight="180"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding CurrentReview.SelectedMarkdown}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="FeedReviewSelectionText"
                               AutomationProperties.Name="{Binding CurrentReview.SelectedMarkdown}" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  IsVisible="{Binding !HasCreatedTask}">
                <ComboBox ItemsSource="{Binding Areas}"
                          SelectedItem="{Binding ReviewDestinationArea, Mode=TwoWay}"
                          IsEnabled="{Binding CanModifyReviewSource}"
                          SelectionChanged="OnReviewAreaSelectionChanged"
                          AutomationProperties.AutomationId="FeedReviewAreaPicker">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="feed:FeedAreaOptionViewModel">
                            <TextBlock Text="{Binding DestinationDisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <WrapPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,4,0"
                            Padding="8,4"
                            IsEnabled="{Binding CurrentReview.CanExpandUp}"
                            Command="{Binding ExpandSelectionUpCommand}"
                            Content="↑+"
                            AutomationProperties.Name="{DynamicResource FeedReviewExpandUp}"
                            AutomationProperties.AutomationId="FeedReviewExpandUpButton" />
                    <Button Margin="0,0,4,0"
                            Padding="8,4"
                            IsEnabled="{Binding CurrentReview.CanExpandDown}"
                            Command="{Binding ExpandSelectionDownCommand}"
                            Content="↓+"
                            AutomationProperties.Name="{DynamicResource FeedReviewExpandDown}"
                            AutomationProperties.AutomationId="FeedReviewExpandDownButton" />
                    <Button Margin="0,0,4,0"
                            Padding="8,4"
                            IsEnabled="{Binding CurrentReview.CanShrinkUp}"
                            Command="{Binding ShrinkSelectionUpCommand}"
                            Content="↑−"
                            AutomationProperties.Name="{DynamicResource FeedReviewShrinkUp}"
                            AutomationProperties.AutomationId="FeedReviewShrinkUpButton" />
                    <Button Padding="8,4"
                            IsEnabled="{Binding CurrentReview.CanShrinkDown}"
                            Command="{Binding ShrinkSelectionDownCommand}"
                            Content="↓−"
                            AutomationProperties.Name="{DynamicResource FeedReviewShrinkDown}"
                            AutomationProperties.AutomationId="FeedReviewShrinkDownButton" />
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="4"
                  ColumnDefinitions="*,*,*,*,Auto"
                  ColumnSpacing="8"
                  IsVisible="{Binding !HasCreatedTask}">
                <Button Command="{Binding ShowReviewTaskStageCommand}"
                        Content="{DynamicResource FeedReviewTaskAction}"
                        AutomationProperties.AutomationId="FeedReviewTaskActionButton" />
                <Button Grid.Column="1"
                        Command="{Binding ShowReviewNoteStageCommand}"
                        Content="{DynamicResource FeedReviewNoteAction}"
                        AutomationProperties.AutomationId="FeedReviewNoteActionButton" />
                <Button Grid.Column="2"
                        Command="{Binding LeaveReviewCommand}"
                        Content="{DynamicResource FeedReviewLeave}"
                        AutomationProperties.AutomationId="FeedReviewLeaveButton" />
                <Button Grid.Column="3"
                        IsEnabled="{Binding CanMoveReviewToToday}"
                        Command="{Binding MoveToTodayCommand}"
                        Content="{DynamicResource FeedReviewMoveTodayShort}"
                        AutomationProperties.AutomationId="FeedReviewMoveTodayButton" />
                <Button Grid.Column="4"
                        Command="{Binding SkipReviewCommand}"
                        Content="…"
                        AutomationProperties.Name="{DynamicResource FeedReviewSkip}"
                        AutomationProperties.AutomationId="FeedReviewSkipButton" />
            </Grid>

            <ScrollViewer Grid.Row="5"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <Border IsVisible="{Binding IsReviewTaskStage}"
                            Padding="12"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <ToggleSwitch IsChecked="{Binding ReviewTaskIsGoal, Mode=TwoWay}"
                                          Content="{DynamicResource FeedReviewGoal}"
                                          AutomationProperties.AutomationId="FeedReviewTaskGoalToggle" />
                            <ItemsControl ItemsSource="{Binding ReviewTaskAreas}"
                                          AutomationProperties.AutomationId="FeedReviewTaskAreas">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="feed:FeedTaskAreaOptionViewModel">
                                        <CheckBox Margin="0,0,10,4"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Content="{Binding Area.DisplayName}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button HorizontalAlignment="Right"
                                    IsEnabled="{Binding CanCreateReviewTask}"
                                    Command="{Binding CreateTaskCommand}"
                                    Content="{DynamicResource FeedReviewCreateTask}"
                                    AutomationProperties.AutomationId="FeedReviewCreateTaskButton" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsReviewNoteStage}"
                            Padding="12"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding ReviewNoteTitle, Mode=TwoWay}"
                                     PlaceholderText="{DynamicResource FeedReviewNoteTitle}"
                                     AutomationProperties.AutomationId="FeedReviewNoteTitleBox" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding ReviewNoteFolder, Mode=TwoWay}"
                                     PlaceholderText="{DynamicResource FeedReviewNoteFolder}"
                                     AutomationProperties.AutomationId="FeedReviewNoteFolderBox" />
                            <Button Grid.Column="2"
                                    Command="{Binding CreateNoteCommand}"
                                    Content="{DynamicResource FeedReviewCreateNote}"
                                    AutomationProperties.AutomationId="FeedReviewCreateNoteButton" />
                        </Grid>
                    </Border>

                    <Border IsVisible="{Binding HasCreatedTask}"
                            Padding="12"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource SystemAccentColor}"
                            BorderThickness="1"
                            AutomationProperties.AutomationId="FeedTaskInlineSurface">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <local:TaskStatusPicker Task="{Binding CreatedTaskReference.Task}"
                                                        AutomationProperties.AutomationId="FeedTaskStatusPicker" />
                                <Button Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnTaskReferenceClick"
                                        AutomationProperties.AutomationId="FeedTaskTitleButton">
                                    <TextBlock Text="{Binding CreatedTaskReference.DisplayTitle}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </Button>
                                <ToggleSwitch Grid.Column="2"
                                              IsChecked="{Binding CreatedTaskReference.Task.IsGoal, Mode=TwoWay}"
                                              Content="{DynamicResource FeedReviewGoal}"
                                              AutomationProperties.AutomationId="FeedCreatedTaskGoalToggle" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ReviewTaskAreas}"
                                          AutomationProperties.AutomationId="FeedCreatedTaskAreas">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="feed:FeedTaskAreaOptionViewModel">
                                        <CheckBox Margin="0,0,10,4"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Content="{Binding Area.DisplayName}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <views:TaskRelationsControl Owner="{Binding TaskOwner}"
                                                        TargetTask="{Binding CreatedTaskReference.Task}"
                                                        AutomationIdPrefix="FeedTaskParentsRelation"
                                                        ParentsTreeAutomationId="FeedTaskParentsTree"
                                                        OpenParentTaskOnDoubleTap="False" />
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding ContinueReviewCommand}"
                                    Content="{DynamicResource FeedReviewContinue}"
                                    AutomationProperties.AutomationId="FeedReviewContinueButton" />
                        </StackPanel>
                    </Border>

                    <TextBlock IsVisible="{Binding HasError}"
                               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
