<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:feed="clr-namespace:Unlimotion.ViewModel.Feed;assembly=Unlimotion.ViewModel"
             x:Class="Unlimotion.Views.FeedHeadingAreaConversion"
             x:DataType="feed:FeedHeadingAreaConversionViewModel"
             mc:Ignorable="d">
    <Border Margin="16"
            Padding="18"
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            BorderBrush="{DynamicResource FeedAccentBrush}"
            BorderThickness="2"
            CornerRadius="10"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            AutomationProperties.ControlTypeOverride="Pane"
            AutomationProperties.Name="{DynamicResource MarkdownHeadingAreaTitle}"
            AutomationProperties.AutomationId="MarkdownHeadingAreaDialog">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Text="{DynamicResource MarkdownHeadingAreaTitle}" />
                <TextBlock Opacity="0.72"
                           Text="{DynamicResource MarkdownHeadingAreaDescription}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="{DynamicResource MarkdownHeadingAreaExisting}" />
                <ComboBox ItemsSource="{Binding ExistingAreas}"
                          SelectedItem="{Binding SelectedExistingArea, Mode=TwoWay}"
                          AutomationProperties.AutomationId="MarkdownHeadingAreaExistingComboBox">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="feed:FeedHeadingAreaChoice">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource MarkdownHeadingAreaName}" />
                    <TextBox Text="{Binding Name, Mode=TwoWay}"
                             IsEnabled="{Binding IsCreatingNew}"
                             AutomationProperties.AutomationId="MarkdownHeadingAreaNameTextBox" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{DynamicResource MarkdownHeadingAreaParent}" />
                    <ComboBox ItemsSource="{Binding ParentOptions}"
                              SelectedItem="{Binding SelectedParent, Mode=TwoWay}"
                              IsEnabled="{Binding IsCreatingNew}"
                              AutomationProperties.AutomationId="MarkdownHeadingAreaParentComboBox">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="feed:AreaParentOptionViewModel">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3"
                       IsVisible="{Binding HasError}"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       AutomationProperties.AutomationId="MarkdownHeadingAreaErrorText" />

            <StackPanel Grid.Row="4"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Command="{Binding CancelCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Content="{DynamicResource Cancel}"
                        AutomationProperties.AutomationId="MarkdownHeadingAreaCancelButton" />
                <Button Command="{Binding ConfirmCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Content="{DynamicResource MarkdownHeadingAreaConfirm}"
                        AutomationProperties.AutomationId="MarkdownHeadingAreaConfirmButton" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
