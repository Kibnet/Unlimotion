<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:Unlimotion.ViewModel;assembly=Unlimotion.ViewModel"
             xmlns:views="clr-namespace:Unlimotion.Views"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:unlimotion="clr-namespace:Unlimotion"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Unlimotion.Views.MainScreen"
             FontSize="{DynamicResource AppFontSize}"
             x:DataType="viewModel:MainWindowViewModel">

    <Design.DataContext>
        <viewModel:MainWindowViewModel/>
    </Design.DataContext>
    <Panel>
        <dialogHostAvalonia:DialogHost CloseOnClickAway="True" Identifier="Ask" IsOpen="{Binding IsSettingsDialogOpen, Mode=TwoWay}">
            <dialogHostAvalonia:DialogHost.DataTemplates>
                <DataTemplate DataType="unlimotion:AskViewModel">

                    <Grid Margin="10" RowDefinitions="Auto,Auto,Auto">

                        <TextBlock TextAlignment="Center"
								   TextWrapping="Wrap"
								   FontWeight="Bold"
								   Text="{Binding Header}"/>
                        <TextBlock Grid.Row="1" TextAlignment="Center"
								   TextWrapping="Wrap"
								   Text="{Binding Message}" />
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
									HorizontalAlignment="Stretch"
									HorizontalContentAlignment="Center"
									AutomationProperties.AutomationId="AskYesButton"
									Command="{Binding YesCommand}"
									Content="{DynamicResource DialogYes}"/>
                            <Button Grid.Column="1"
									HorizontalAlignment="Stretch"
									HorizontalContentAlignment="Center"
									AutomationProperties.AutomationId="AskNoButton"
									Command="{Binding NoCommand}"
									Content="{DynamicResource DialogNo}"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
                <DataTemplate DataType="unlimotion:TaskOutlinePastePreviewDialogViewModel">
                    <views:TaskOutlinePastePreviewControl />
                </DataTemplate>
                <DataTemplate DataType="viewModel:SettingsViewModel">
                    <views:ConflictResolutionControl />
                </DataTemplate>
            </dialogHostAvalonia:DialogHost.DataTemplates>
            <!-- put the content over which the dialog is shown here (e.g. your main window grid)-->
            <Panel>
                <views:MainControl Name="MainControl"/>
                <ItemsControl x:CompileBindings="False"
                              ItemsSource="{Binding ToastNotificationManager.Messages}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Margin="16"
                              AutomationProperties.AutomationId="ToastNotificationList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="unlimotion:AppToastNotification"
                                      x:DataType="unlimotion:AppToastNotification">
                            <Border MinWidth="280"
                                    MaxWidth="560"
                                    Padding="12,10"
                                    CornerRadius="6"
                                    Background="{Binding Background}"
                                    AutomationProperties.AutomationId="{Binding AutomationId}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            MinWidth="28"
                                            MinHeight="28"
                                            Margin="12,0,0,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="White"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Content="x"
                                            Command="{Binding CloseCommand}"
                                            AutomationProperties.AutomationId="{Binding CloseAutomationId}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Panel.ZIndex="110"
                      IsVisible="{Binding IsSettingsOpen}"
                      Background="#99000000"
                      AutomationProperties.AutomationId="GlobalSettingsOverlay">
                    <Border Width="1040" MaxWidth="{Binding $parent[Panel].Bounds.Width}"
                            MaxHeight="760" Margin="24" Padding="16" CornerRadius="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                            <Button x:Name="GlobalSettingsCloseButton" Grid.Row="0" HorizontalAlignment="Right" Padding="8,2" Content="×"
                                    Command="{Binding CloseSettingsCommand}"
                                    AutomationProperties.Name="{DynamicResource Close}"
                                    AutomationProperties.AutomationId="GlobalSettingsCloseButton"/>
                            <Border Grid.Row="1" IsVisible="{Binding Settings.IsSourceMutationBlocked}"
                                    AutomationProperties.ControlTypeOverride="Group"
                                    AutomationProperties.IsControlElementOverride="True"
                                    AutomationProperties.Name="{Binding Settings.SourceBusyStatusText}"
                                    AutomationProperties.AutomationId="SettingsBusyStatus">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Settings.SourceBusyStatusText}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource SettingsSourceBusyHint}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <views:SettingsControl Grid.Row="2" DataContext="{Binding Settings}"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="SettingsHotkeyHelpOverlayHost" Panel.ZIndex="120"
                      IsVisible="False" Focusable="True" Background="#66000000"
                      AutomationProperties.AutomationId="SettingsHotkeyHelpOverlayHost">
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            MaxWidth="560" MaxHeight="{Binding $parent[Grid].Bounds.Height}"
                            CornerRadius="6" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                        <views:HotkeyHelpPanel x:Name="SettingsHotkeyHelpPanel"/>
                    </Border>
                </Grid>

            </Panel>
        </dialogHostAvalonia:DialogHost>
    </Panel>
</UserControl>
