{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kibnet/Unlimotion/blob/main/distribution/release-assets.schema.json",
  "title": "Unlimotion release asset contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "product",
    "tagPolicy",
    "supportLevels",
    "androidProductionCertificateSha256",
    "retryPolicy",
    "linuxRuntimePrerequisites",
    "assets",
    "relations"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "Unlimotion"
    },
    "tagPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedRead",
        "publicationWrite",
        "stableOnly",
        "minimumVersion"
      ],
      "properties": {
        "acceptedRead": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "MAJOR.MINOR.PATCH",
              "vMAJOR.MINOR.PATCH"
            ]
          }
        },
        "publicationWrite": {
          "const": "deferred-to-stage-4"
        },
        "stableOnly": {
          "const": true
        },
        "minimumVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "supportLevels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "present",
          "metadataVerified",
          "launchVerified",
          "productionReady"
        ]
      }
    },
    "androidProductionCertificateSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic",
        "aptNetwork",
        "emulatorBoot",
        "artifactTransport"
      ],
      "properties": {
        "deterministic": {
          "$ref": "#/definitions/retryRule"
        },
        "aptNetwork": {
          "$ref": "#/definitions/retryRule"
        },
        "emulatorBoot": {
          "$ref": "#/definitions/retryRule"
        },
        "artifactTransport": {
          "$ref": "#/definitions/retryRule"
        }
      }
    },
    "linuxRuntimePrerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appImageExtractAndRun", "directFuseAdditional"],
      "properties": {
        "appImageExtractAndRun": {
          "type": "object",
          "additionalProperties": false,
          "required": ["debian12", "debian13"],
          "properties": {
            "debian12": {
              "const": ["ca-certificates", "libc6", "libgcc-s1", "libgssapi-krb5-2", "libstdc++6", "tzdata", "zlib1g", "libx11-6", "libice6", "libsm6", "libfontconfig1", "libicu72", "libssl3"]
            },
            "debian13": {
              "const": ["ca-certificates", "libc6", "libgcc-s1", "libgssapi-krb5-2", "libstdc++6", "tzdata", "zlib1g", "libx11-6", "libice6", "libsm6", "libfontconfig1", "libicu76", "libssl3t64"]
            }
          }
        },
        "directFuseAdditional": {
          "type": "object",
          "additionalProperties": false,
          "required": ["debian12", "debian13"],
          "properties": {
            "debian12": { "const": ["libfuse2"] },
            "debian13": { "const": ["libfuse2t64"] }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/asset"
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/relation"
      }
    }
  },
  "definitions": {
    "retryRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAttempts",
        "cleanup",
        "retryableClassification"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "cleanup": {
          "type": "string",
          "minLength": 1
        },
        "retryableClassification": {
          "enum": [
            "never",
            "infrastructure-only"
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform",
        "architecture",
        "role",
        "filenameTemplate",
        "producer",
        "validatorProfile",
        "requiredEvidence",
        "signatureRequirement",
        "stage3MaximumSupport",
        "releaseVisible",
        "legacy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "platform": {
          "enum": [
            "windows",
            "linux",
            "macos",
            "android"
          ]
        },
        "architecture": {
          "enum": [
            "x64",
            "arm64"
          ]
        },
        "role": {
          "enum": [
            "userInstaller",
            "userPortable",
            "updaterPackage",
            "updaterFeed",
            "legacyDuplicate"
          ]
        },
        "filenameTemplate": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "producer": {
          "enum": [
            "windows-packaging",
            "linux-packaging",
            "macos-packaging",
            "android-packaging"
          ]
        },
        "validatorProfile": {
          "enum": [
            "velopack-releases-legacy",
            "velopack-json",
            "velopack-package",
            "windows-setup",
            "windows-portable",
            "legacy-windows-portable",
            "debian-amd64",
            "appimage-x64",
            "macos-pkg",
            "macos-portable",
            "legacy-macos-pkg",
            "android-apk"
          ]
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "inventory",
              "metadata",
              "feedRelation",
              "architecture",
              "install",
              "launch",
              "signature"
            ]
          }
        },
        "signatureRequirement": {
          "enum": [
            "notApplicable",
            "recordStatus",
            "productionCertificate"
          ]
        },
        "stage3MaximumSupport": {
          "enum": [
            "present",
            "metadataVerified",
            "launchVerified"
          ]
        },
        "releaseVisible": {
          "type": "boolean"
        },
        "legacy": {
          "type": "boolean"
        },
        "legacyOwner": {
          "type": "string",
          "minLength": 1
        },
        "migrationStage": {
          "type": "integer",
          "minimum": 4
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "legacy": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "legacyOwner",
              "migrationStage"
            ]
          }
        }
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "feedAssetId",
        "packageAssetId",
        "channel",
        "format",
        "hashAlgorithm",
        "packageId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "feedAssetId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "packageAssetId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "channel": {
          "enum": [
            "windows",
            "linux",
            "macos-x64",
            "macos-arm64"
          ]
        },
        "format": {
          "enum": [
            "squirrel-releases-v1",
            "velopack-json-v1"
          ]
        },
        "hashAlgorithm": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "packageId": {
          "const": "Unlimotion"
        }
      }
    }
  }
}
