{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kibnet/Unlimotion/blob/main/distribution/support-matrix.schema.json",
  "title": "Unlimotion public distribution support snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "product",
    "release",
    "candidateEvidenceAccepted",
    "productionReadyDerived",
    "lastPublishedAndroidVersionCode",
    "claims"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "Unlimotion"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawTag",
        "normalizedVersion",
        "sourceSha",
        "publishedAt",
        "releaseUrl"
      ],
      "properties": {
        "rawTag": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "normalizedVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "releaseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/Kibnet/Unlimotion/releases/tag/"
        }
      }
    },
    "candidateEvidenceAccepted": {
      "const": false
    },
    "productionReadyDerived": {
      "const": true
    },
    "lastPublishedAndroidVersionCode": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2100000000
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/claim"
      }
    }
  },
  "definitions": {
    "assetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "name",
        "sha256"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "verifiedCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "version",
        "architecture",
        "evidence"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "enum": [
            "x64",
            "arm64"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "metadata",
              "install",
              "launch",
              "signature"
            ]
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform",
        "architecture",
        "distribution",
        "releaseTag",
        "sourceSha",
        "publicStatus",
        "evidenceLevel",
        "assets",
        "verifiedCells",
        "caveats",
        "readmeCaveatIds",
        "durableEvidenceUrls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "platform": {
          "enum": [
            "windows",
            "linux",
            "macos",
            "android"
          ]
        },
        "architecture": {
          "enum": [
            "x64",
            "arm64"
          ]
        },
        "distribution": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "releaseTag": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "publicStatus": {
          "enum": [
            "publishedWithCaveats",
            "preview"
          ]
        },
        "evidenceLevel": {
          "enum": [
            "present",
            "metadataVerified",
            "launchVerified",
            "productionReady"
          ]
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/assetReference"
          }
        },
        "verifiedCells": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/verifiedCell"
          }
        },
        "caveats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "readmeCaveatIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "durableEvidenceUrls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
